# 17:00 in TZ (America/New_York, set in fly.toml), so the Morning Note covers the full US session.
# timeout: a stalled job (AI Adoption has no per-company cap) can't block the next day's run.
# flock: every publish takes the same lock, so two Vercel builds never run at once.
0 17 * * * cd /app && flock /tmp/arc-publish.lock timeout 3h scripts/publish_server.sh >> data/publish.log 2>&1
# Theme Charts (agents/themes.py): the #1 macro theme at 08:00 on weekdays only, then a code-only publish
# (no data refresh, no Substack). A failed run exits non-zero, so the site keeps the previous one.
# No approval step: publish the run on Substack (a failure never stops the
# line), redeploy so /themes shows its card, then post it to X as a thread linking the Substack post.
0 8 * * 1-5 cd /app && flock /tmp/arc-publish.lock timeout 1h sh -c 'python -m castelino.agents.themes && python -m castelino.agents.themes --substack && SKIP_SUBSTACK=1 scripts/publish_server.sh --no-refresh && python -m castelino.agents.themes --post' >> data/themes.log 2>&1
# The /models cards at 09:30, after the 08:30 releases (CPI, Empire State, Philly Fed) reach FRED:
# Pulse/Pressure refit, Sector Sentiment, Cross-Asset, then a publish (no Substack). AI Adoption stays
# on the 17:00 run: it can take hours.
30 9 * * * cd /app && flock /tmp/arc-publish.lock timeout 1h env SKIP_SUBSTACK=1 scripts/publish_server.sh --jobs=model_refit,sector_sentiment,cross_asset >> data/publish.log 2>&1
# Market alerts (x_moves.py): every 30 min, the job itself skips outside 9:35-16:05 ET on weekdays.
# Dry run (log only) until X_MOVES_LIVE=1 and the four X_API_* / X_ACCESS_* keys are Fly secrets.
5,35 9-16 * * 1-5 cd /app && timeout 10m python -m castelino.x_moves >> data/x_moves.log 2>&1
# X Scout (x_scout.py), one system, three jobs, one log; dry run (log only) until X_SCOUT_LIVE=1 is a Fly secret.
# scout: one cited macro or AI finding with a chart, every 2 h: 10:15 to 22:15 ET on weekdays (7), 08:15 to 22:15
#   at weekends (8). Weekdays start at 10:15 so the 08:00 Theme Charts thread (done by 09:00, its 1h timeout) has
#   the feed to itself for an hour; a run within an hour of that thread's last post is skipped too.
# card: 07:00 on weekdays, the week's calendar card on Mondays and today's Tuesday to Friday.
# watch: every 5 min from 07:00 to 23:55 on weekdays, a post for each watched release as it lands (at most 7 a
#   day), its number read from Trading Economics; till 23:55 so Japan's 19:30 releases are caught; release posts
#   may land in the Theme Charts quiet hour: they are news.
15 10-22/2 * * 1-5 cd /app && timeout 10m python -m castelino.x_scout scout >> data/x_scout.log 2>&1
15 8-22/2 * * 0,6 cd /app && timeout 10m python -m castelino.x_scout scout >> data/x_scout.log 2>&1
0 7 * * 1-5 cd /app && timeout 10m python -m castelino.x_scout card >> data/x_scout.log 2>&1
*/5 7-23 * * 1-5 cd /app && timeout 4m python -m castelino.x_scout watch >> data/x_scout.log 2>&1
