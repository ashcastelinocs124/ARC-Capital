# 17:00 in TZ (America/New_York, set in fly.toml), so the Morning Note covers the full US session.
# timeout: a stalled job (AI Adoption has no per-company cap) can't block the next day's run.
# flock: every publish takes the same lock, so two Vercel builds never run at once.
0 17 * * * cd /app && flock /tmp/arc-publish.lock timeout 3h scripts/publish_server.sh >> data/publish.log 2>&1
# Theme Charts (agents/themes.py): the #1 macro theme at 08:00 and 20:00, then a code-only publish
# (no data refresh, no Substack). A failed run exits non-zero, so the site keeps the previous one.
0 8,20 * * * cd /app && flock /tmp/arc-publish.lock timeout 1h sh -c 'python -m castelino.agents.themes && SKIP_SUBSTACK=1 scripts/publish_server.sh --no-refresh' >> data/themes.log 2>&1
# The /models cards at 09:30, after the 08:30 releases (CPI, Empire State, Philly Fed) reach FRED:
# Pulse/Pressure refit, Sector Sentiment, Cross-Asset, then a publish (no Substack). AI Adoption stays
# on the 17:00 run: it can take hours.
30 9 * * * cd /app && flock /tmp/arc-publish.lock timeout 1h env SKIP_SUBSTACK=1 scripts/publish_server.sh --jobs=model_refit,sector_sentiment,cross_asset >> data/publish.log 2>&1
# Market alerts (x_moves.py): every 30 min, the job itself skips outside 9:35-16:05 ET on weekdays.
# Dry run (log only) until X_MOVES_LIVE=1 and the four X_API_* / X_ACCESS_* keys are Fly secrets.
5,35 9-16 * * 1-5 cd /app && timeout 10m python -m castelino.x_moves >> data/x_moves.log 2>&1
